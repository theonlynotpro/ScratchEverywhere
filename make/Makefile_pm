.PHONY: all clean debug release

TARGET     := Scratch-pm
BUILD      := build/pm
SOURCES    := source source/runtime source/runtime/blocks source/menus source/renderers/sdl2 source/windowing/sdl2 source/audio/sdl2 include/miniz include/nlohmann include/ryu
INCLUDES   := include $(SOURCES)

CXX        := g++
CC         := gcc

GRAPHICS   := gfx
GFXBUILD   := romfs/gfx

# SDL via pkg-config
SDL_CFLAGS := $(shell pkg-config --cflags sdl2 SDL2_image SDL2_ttf SDL2_mixer)
SDL_LIBS   := $(shell pkg-config --libs sdl2 SDL2_image SDL2_ttf SDL2_mixer)

# Base compiler flags
CXXFLAGS_BASE := -std=c++17 -Wall -D__PC__ -fexceptions -I/usr/local/include -I/usr/local/include/SDL2
CFLAGS_BASE   := -D__PC__

# Debug and Release flags
CXXFLAGS_DEBUG   := $(CXXFLAGS_BASE) -g -O0 -DDEBUG
CXXFLAGS_RELEASE := $(CXXFLAGS_BASE) -O2 -DNDEBUG

CFLAGS_DEBUG     := $(CFLAGS_BASE) -g -O0 -DDEBUG
CFLAGS_RELEASE   := $(CFLAGS_BASE) -O2 -DNDEBUG

LDFLAGS := $(SDL_LIBS) -lpthread -ldl

# Find all .cpp and .c files recursively
SRC_CPP := $(foreach dir,$(SOURCES),$(wildcard $(dir)/*.cpp))
SRC_C   := $(foreach dir,$(SOURCES),$(wildcard $(dir)/*.c))

# Convert source files to object files in the build dir
OBJS_CPP := $(foreach src,$(SRC_CPP),$(BUILD)/$(src:.cpp=.o))
OBJS_C   := $(foreach src,$(SRC_C),$(BUILD)/$(src:.c=.o))
OBJS     := $(OBJS_CPP) $(OBJS_C)

INCLUDE_FLAGS := $(foreach dir,$(INCLUDES),-I$(dir))

all: debug

debug: CXXFLAGS := $(CXXFLAGS_DEBUG)
debug: CFLAGS   := $(CFLAGS_DEBUG)
debug: $(BUILD)/debug/$(TARGET)

release: CXXFLAGS := $(CXXFLAGS_RELEASE)
release: CFLAGS   := $(CFLAGS_RELEASE)
release: $(BUILD)/release/$(TARGET)

# Link debug
$(BUILD)/debug/$(TARGET): $(patsubst $(BUILD)/%,$(BUILD)/debug/%,$(OBJS))
	@mkdir -p $(dir $@)
	@echo "Linking debug build..."
	@$(CXX) $^ -o $@ $(LDFLAGS)
	@echo "Built debug $(TARGET)"

# Link release
$(BUILD)/release/$(TARGET): $(patsubst $(BUILD)/%,$(BUILD)/release/%,$(OBJS))
	@mkdir -p $(dir $@)
	@echo "Linking release build..."
	@$(CXX) $^ -o $@ $(LDFLAGS)
	@echo "Built release $(TARGET)"

# Compile C++ debug
$(BUILD)/debug/%.o: %.cpp
	@mkdir -p $(dir $@)
	@echo "Compiling debug $<"
	@$(CXX) $(CXXFLAGS) $(INCLUDE_FLAGS) $(SDL_CFLAGS) -c $< -o $@

# Compile C debug
$(BUILD)/debug/%.o: %.c
	@mkdir -p $(dir $@)
	@echo "Compiling debug $<"
	@$(CC) $(CFLAGS) $(INCLUDE_FLAGS) $(SDL_CFLAGS) -c $< -o $@

# Compile C++ release
$(BUILD)/release/%.o: %.cpp
	@mkdir -p $(dir $@)
	@echo "Compiling release $<"
	@$(CXX) $(CXXFLAGS) $(INCLUDE_FLAGS) $(SDL_CFLAGS) -c $< -o $@

# Compile C release
$(BUILD)/release/%.o: %.c
	@mkdir -p $(dir $@)
	@echo "Compiling release $<"
	@$(CC) $(CFLAGS) $(INCLUDE_FLAGS) $(SDL_CFLAGS) -c $< -o $@

clean:
	rm -rf $(BUILD)
